# Everything prefixed EXPO_PUBLIC_ is bundled into the client and is
# public application configuration -- never put a secret here.
#
# Development: point at your backend however it's reachable from the
# device/simulator running the app (localhost for web/simulator on the
# same machine, your machine's LAN IP for a physical device on Expo Go).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Production builds must use an https:// origin -- enforced at
# startup by src/constants/config.ts, not just documented here.
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Release URL seams (V1 account recovery / release-foundation pass). All
# optional -- Settings simply omits a link whose URL isn't set. If set in a
# production build, each must be https:// (enforced by src/constants/
# config.ts). This pass does NOT author the privacy policy/terms/support
# content itself -- these are external pages this app only links to.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy
# EXPO_PUBLIC_TERMS_URL=https://example.com/terms
# EXPO_PUBLIC_SUPPORT_URL=https://example.com/support
# EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://example.com/delete-account
