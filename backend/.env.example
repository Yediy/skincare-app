ENVIRONMENT=development
ENABLE_DOCS=true
DATABASE_URL=postgresql://skincare_app:skincare_app_dev_only@localhost:5432/skincare
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
ALLOWED_ORIGINS=["*"]
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Optional -- see PRODUCTION_ARCHITECTURE.md / DOKPLOY_DEPLOYMENT.md. Unset
# is fine; nothing in the application depends on these yet.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# Rate limiting (see USAGE_AND_RATE_LIMIT_ARCHITECTURE.md). All optional --
# defaults shown are what the application uses if unset.
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_ANALYSIS_MAX=20
# RATE_LIMIT_ANALYSIS_WINDOW_SECONDS=3600
# RATE_LIMIT_GENERAL_MAX=120
# RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
# Reverse-proxy IPs allowed to set X-Forwarded-For for IP-based rate-limit
# keying (JSON array of strings). Empty/unset means only the direct TCP
# peer is ever trusted -- correct behind no proxy, but also correct (just
# less useful) behind an undeclared one, so this is safe to leave unset.
# TRUSTED_PROXIES=[]
