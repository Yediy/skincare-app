ENVIRONMENT=development
ENABLE_DOCS=true
DATABASE_URL=postgresql://skincare_app:skincare_app_dev_only@localhost:5432/skincare
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=
ALLOWED_ORIGINS=["*"]
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Optional -- see PRODUCTION_ARCHITECTURE.md / DOKPLOY_DEPLOYMENT.md. Unset
# is fine; nothing in the application depends on these yet.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=

# Rate limiting (see USAGE_AND_RATE_LIMIT_ARCHITECTURE.md). All optional --
# defaults shown are what the application uses if unset.
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_ANALYSIS_MAX=20
# RATE_LIMIT_ANALYSIS_WINDOW_SECONDS=3600
# RATE_LIMIT_GENERAL_MAX=120
# RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
# Reverse-proxy IPs allowed to set X-Forwarded-For for IP-based rate-limit
# keying (JSON array of strings). Empty/unset means only the direct TCP
# peer is ever trusted -- correct behind no proxy, but also correct (just
# less useful) behind an undeclared one, so this is safe to leave unset.
# TRUSTED_PROXIES=[]

# RevenueCat billing synchronization (see BILLING_ARCHITECTURE.md). All
# unset/false by default -- the application keeps using
# FreeTierEntitlementService unmodified until REVENUECAT_BILLING_ENABLED=true.
# REVENUECAT_BILLING_ENABLED=false
# REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_WEBHOOK_SIGNING_SECRET=
# REVENUECAT_API_KEY=
# REVENUECAT_PROJECT_ID=
# REVENUECAT_ENTITLEMENT_ID=premium
# Dedicated connection string for the billing-writer role (migrations
# 9815eb266923, 4e5cda3a6bb0, 1367b870bdcd) -- NOT the same value as
# DATABASE_URL. `skincare_billing` itself is, at migration head, a
# NOLOGIN privilege role (created LOGIN by 9815eb266923, transitioned
# to NOLOGIN by the separate, later migration 1367b870bdcd -- never
# edited in place, since 9815eb266923 is already merged/applied
# elsewhere) -- no password, not connectable, never what you put in
# this URL. Instead, provision a separate LOGIN role OUTSIDE of any
# schema migration (e.g. `skincare_billing_runtime`), with a secret from
# your own secret manager, then run once, as a superuser, outside this
# app's migration tooling:
#   GRANT skincare_billing TO skincare_billing_runtime;
# and point this at THAT login. Required whenever REVENUECAT_BILLING_
# ENABLED=true in production; webhook ingestion, the RevenueCat worker,
# and reconciliation all connect through this DSN instead, since the
# ordinary skincare_app role cannot write revenuecat_webhook_events/
# user_entitlements, or claim/ack/fail a revenuecat_webhook job, at all.
# Never use a known dev/CI credential here (e.g. skincare_billing_dev_only,
# only ever valid for tests/conftest.py's own local test role) --
# app/config.py rejects it in production regardless.
# REVENUECAT_BILLING_DATABASE_URL=postgresql://skincare_billing_runtime:CHANGE_ME_EXTERNALLY_PROVISIONED_SECRET@localhost:5432/skincare
